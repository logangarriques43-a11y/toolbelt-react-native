{
  "expo": {
    "name": "ToolBelt",
    "slug": "toolbelt-react-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "toolbelt",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "tools.toolbelt.app"
    },
    "android": {
      "package": "tools.toolbelt.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "",
          "enableGooglePay": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ToolBelt uses the camera to scan product barcodes and package labels into your inventory.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "ToolBelt imports the contacts you choose as clients or staff."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "ToolBelt imports appointments from your calendar."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ToolBelt attaches the photos you choose to clients, staff and appointments.",
          "cameraPermission": "ToolBelt uses the camera to take client, staff and appointment photos."
        }
      ],
      [
        "@stripe/stripe-terminal-react-native",
        {
          "bluetoothBackgroundMode": false,
          "locationWhenInUsePermission": "ToolBelt uses your location to accept in-person card payments with Tap to Pay.",
          "bluetoothPeripheralPermission": "ToolBelt uses Bluetooth to connect to card readers.",
          "bluetoothAlwaysUsagePermission": "ToolBelt uses Bluetooth to connect to card readers."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ToolBelt uses your location to find vendors near you and to accept Tap to Pay payments."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "874c5a7f-97f1-49e4-bd72-fa7ab8e83f06"
      }
    },
    "owner": "toolbelt-tools"
  }
}
