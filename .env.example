# Copy to .env and fill in. ALL values are EXPO_PUBLIC_* — they are embedded in
# the client bundle by design and are NOT secrets (the Firebase/Google web API
# key is a public identifier; access is controlled by Firestore rules + App
# Check, not key secrecy). Never put real secrets (Stripe secret, Twilio,
# Anthropic, service-account keys) here — those live server-side only.

# Backend API base (defaults to the production URL in src/config/api.ts if unset)
EXPO_PUBLIC_API_BASE_URL=https://your-backend.example.com/api/v1

# Firebase web app config (from the Firebase console → Project settings → Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# NOTE: Google Play Billing (react-native-iap) needs NO client key — purchase
# tokens are verified server-side against the Play Developer API by the backend.
