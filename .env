# Backend API base URL — the SAME production host the Swift app points at
# (ToolBelt/Core/APIService.swift), so the RN app hits the same backend and your
# Swift test account works. Public (safe to commit). Expo inlines EXPO_PUBLIC_*.
EXPO_PUBLIC_API_BASE_URL=https://toolbelt-backend-dtvy.onrender.com/api/v1

# Firebase (project toolbelt-b2ef6). PUBLIC client config values, pulled from
# the Swift app's GoogleService-Info.plist — same project the backend verifies
# tokens against. Safe to commit. Changing these needs `npx expo start -c`
# (EXPO_PUBLIC_* are inlined at bundle time).
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyBOa16BqD8uEU_60D9DdxatwHISnUgfJzM
