# Backend API base URL — the SAME production host the Swift app points at
# (ToolBelt/Core/APIService.swift), so the RN app hits the same backend and your
# Swift test account works. Public (safe to commit). Expo inlines EXPO_PUBLIC_*.
EXPO_PUBLIC_API_BASE_URL=https://toolbelt-backend-dtvy.onrender.com/api/v1

# Firebase (project toolbelt-b2ef6). These are PUBLIC client config values.
# Everything below is filled from the known project except the API KEY, which is
# the one value not present in the repo. Paste it from:
#   Firebase Console → Project settings → General → Your apps → (Web app) SDK
#   config → apiKey (an "AIza..." string), OR the API_KEY in GoogleService-Info.plist.
EXPO_PUBLIC_FIREBASE_API_KEY=PASTE_FIREBASE_WEB_API_KEY_HERE
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=toolbelt-b2ef6.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=toolbelt-b2ef6
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=toolbelt-b2ef6.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=867777580265
# appId is optional for email/password Auth; paste the web appId if you have one.
EXPO_PUBLIC_FIREBASE_APP_ID=
